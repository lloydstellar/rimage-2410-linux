# Copy to /etc/default/rimage-web and adjust.
RIMAGE_HOST=0.0.0.0
RIMAGE_PORT=8080
RIMAGE_DATA_DIR=/var/lib/rimage
# Access code for the login; empty = no login (only advisable on a trusted network).
RIMAGE_ACCESS_CODE=
# Maximum upload size in MB (5000 fits ISO images up to a full DVD).
RIMAGE_MAX_UPLOAD_MB=2048
